<view class="title">记录</view>
<view class="sub">本地保存 · 与 Web / APK / EXE 端同一份数据结构</view>

<view class="card" style="padding:10px 14px">
  <input class="search" placeholder="按日期或备注关键词筛选" value="{{keyword}}" bindinput="onKeyword" />
</view>

<view class="btn" bindtap="openAdd" wx:if="{{!showForm}}">+ 新增记录</view>

<view class="card" wx:if="{{showForm}}">
  <view class="muted">{{form.id ? '编辑记录' : '新增记录'}}</view>

  <view class="frow">
    <text class="flabel">日期</text>
    <picker mode="date" value="{{form.date}}" end="{{today}}" bindchange="onDate">
      <view class="pick">{{form.date || '选择日期'}}</view>
    </picker>
  </view>
  <view class="err" wx:if="{{errors.date}}">{{errors.date}}</view>

  <view class="frow">
    <text class="flabel">时间</text>
    <picker mode="time" value="{{form.time}}" bindchange="onField" data-k="time">
      <view class="pick">{{form.time || '选填'}}</view>
    </picker>
  </view>

  <block wx:for="{{metrics}}" wx:key="key" wx:for-item="m">
    <view class="frow">
      <text class="flabel">{{m.label}}</text>
      <text class="muted">{{form[m.key]}} {{m.unit}}</text>
    </view>
    <slider class="sl" min="{{m.min}}" max="{{m.max}}" step="{{m.step}}" value="{{form[m.key]}}"
            activeColor="#2f6f62" block-size="20" data-k="{{m.key}}" data-step="{{m.step}}" bindchange="onSlider" />
    <view class="err" wx:if="{{errors[m.key]}}">{{errors[m.key]}}</view>
  </block>

  <view class="muted" style="margin-top:10px">备注（≤500 字）</view>
  <textarea class="ta" value="{{form.note}}" maxlength="500" auto-height bindinput="onField" data-k="note" />
  <view class="err" wx:if="{{errors.note}}">{{errors.note}}</view>

  <view class="btn" bindtap="save">保存</view>
  <view class="btn ghost" bindtap="closeForm">取消</view>
</view>

<view class="card">
  <view class="row" wx:for="{{filtered}}" wx:key="id">
    <view style="flex:1" data-id="{{item.id}}" bindtap="openEditItem">
      <view>{{item.date}} <text class="muted">{{item.time}}</text></view>
      <view class="muted">{{item.mood}} / {{item.sleep}} / {{item.heartRate}} / {{item.stress}}</view>
      <view class="muted" wx:if="{{item.note}}">{{item.note}}</view>
    </view>
    <view class="badge off" data-id="{{item.id}}" catchtap="remove">删除</view>
  </view>
  <view class="muted" wx:if="{{!filtered.length}}" style="padding:8px 0">
    {{list.length ? '没有符合条件的记录' : '还没有记录'}}
  </view>
</view>

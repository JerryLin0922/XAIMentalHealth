<view class="title">心情看板</view>
<view class="sub">四项指标近期均值 · 共 {{count}} 条记录</view>

<view class="card">
  <view class="metric"><view class="muted">心情</view><view class="v">{{mood}}</view></view>
  <view class="metric"><view class="muted">睡眠(h)</view><view class="v">{{sleep}}</view></view>
  <view class="metric"><view class="muted">心率(bpm)</view><view class="v">{{hr}}</view></view>
  <view class="metric"><view class="muted">压力</view><view class="v">{{stress}}</view></view>
</view>

<view class="title" style="font-size:16px">最近记录</view>
<view class="card" wx:if="{{recent.length}}">
  <view class="row" wx:for="{{recent}}" wx:key="id">
    <view>{{item.date}} <text class="muted">{{item.time}}</text></view>
    <view class="muted">心情 {{item.mood}} · 睡眠 {{item.sleep}}</view>
  </view>
</view>
<view class="card" wx:else><view class="muted">还没有记录，去「记录」添加第一条吧。</view></view>

<view class="btn ghost" bindtap="goRecords">去记录</view>
